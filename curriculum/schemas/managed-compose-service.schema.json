{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudnative.co.jp/schemas/auth-authz/managed-compose-service.schema.json",
  "title": "Course managed Compose service",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "courseId", "installId", "resourceId", "composeProject", "composeFile", "buildServices", "targetServices", "expectedServices", "expectedNetworks", "expectedVolumes", "noDependencies", "publishedPorts", "composeEnvironment", "supplementalFiles", "configDigest", "labels", "containers", "networks", "volumes", "status", "createdAt", "updatedAt"],
  "properties": {
    "$schema": { "const": "curriculum/schemas/managed-compose-service.schema.json" },
    "schemaVersion": { "const": 1 },
    "courseId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "installId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "resourceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "composeProject": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,62}$" },
    "composeFile": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+\\.ya?ml$" },
    "buildServices": { "$ref": "#/$defs/serviceNames" },
    "targetServices": { "$ref": "#/$defs/serviceNames" },
    "expectedServices": { "$ref": "#/$defs/serviceNames" },
    "expectedNetworks": { "$ref": "#/$defs/resourceKeys" },
    "expectedVolumes": { "$ref": "#/$defs/resourceKeys" },
    "noDependencies": { "type": "boolean" },
    "publishedPorts": {
      "type": "array",
      "items": { "$ref": "#/$defs/publishedPort" },
      "maxItems": 32
    },
    "composeEnvironment": {
      "type": "array",
      "items": { "$ref": "#/$defs/environmentEntry" },
      "maxItems": 32
    },
    "supplementalFiles": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
      "uniqueItems": true,
      "maxItems": 32
    },
    "configDigest": { "$ref": "#/$defs/sha256" },
    "labels": { "$ref": "#/$defs/labels" },
    "containers": {
      "type": "array",
      "items": { "$ref": "#/$defs/container" },
      "maxItems": 32
    },
    "networks": {
      "type": "array",
      "items": { "$ref": "#/$defs/network" },
      "maxItems": 32
    },
    "volumes": {
      "type": "array",
      "items": { "$ref": "#/$defs/volume" },
      "maxItems": 32
    },
    "status": { "enum": ["pending", "running", "stopped"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "environmentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "value": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["courseId", "installId", "resourceId", "composeProject"],
      "properties": {
        "courseId": { "type": "string", "minLength": 1 },
        "installId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "resourceId": { "type": "string", "minLength": 1 },
        "composeProject": { "type": "string", "minLength": 1 }
      }
    },
    "serviceNames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
      "uniqueItems": true
    },
    "resourceKeys": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
      "uniqueItems": true
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceName", "containerId", "composeConfigHash", "status"],
      "properties": {
        "serviceName": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "containerId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "composeConfigHash": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          ]
        },
        "status": { "enum": ["running", "stopped"] }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["networkKey", "networkId", "name"],
      "properties": {
        "networkKey": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
        "networkId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volumeKey", "name"],
      "properties": {
        "volumeKey": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" }
      }
    },
    "publishedPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceName", "host", "hostPort", "containerPort", "protocol"],
      "properties": {
        "serviceName": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "host": { "const": "127.0.0.1" },
        "hostPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "const": "tcp" }
      }
    }
  }
}

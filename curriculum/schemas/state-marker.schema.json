{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudnative.co.jp/schemas/auth-authz/state-marker.schema.json",
  "title": "Course runtime state identity marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "courseId", "repositoryRealpath", "installId", "sourceRevision", "sourceDigest", "createdAt"],
  "oneOf": [
    {
      "properties": { "schemaVersion": { "const": 1 } },
      "not": { "required": ["nodeMajor"] }
    },
    {
      "required": ["nodeMajor"],
      "properties": { "schemaVersion": { "const": 2 } }
    }
  ],
  "properties": {
    "$schema": { "const": "curriculum/schemas/state-marker.schema.json" },
    "schemaVersion": { "enum": [1, 2] },
    "nodeMajor": { "enum": [24, 26] },
    "courseId": { "type": "string", "minLength": 1 },
    "repositoryRealpath": { "type": "string", "minLength": 1 },
    "installId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "sourceRevision": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
      ]
    },
    "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}

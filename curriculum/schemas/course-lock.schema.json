{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudnative.co.jp/schemas/auth-authz/course-lock.schema.json",
  "title": "Unreleased course source lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "courseId", "releaseStatus", "sourceRevision", "sourceFile", "generatedFiles"],
  "properties": {
    "$schema": { "const": "./curriculum/schemas/course-lock.schema.json" },
    "schemaVersion": { "const": 1 },
    "courseId": { "type": "string", "minLength": 1 },
    "releaseStatus": { "const": "unreleased" },
    "sourceRevision": { "type": "null" },
    "sourceFile": { "$ref": "#/$defs/fileDigest" },
    "generatedFiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fileDigest" }
    }
  },
  "$defs": {
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudnative.co.jp/schemas/auth-authz/course-contract.schema.json",
  "title": "Generated course traceability contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "courseId", "title", "source", "courseOutcomes", "lessons", "traceability"],
  "properties": {
    "$schema": { "const": "./schemas/course-contract.schema.json" },
    "schemaVersion": { "const": 1 },
    "courseId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schemaVersion", "sha256", "revision"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "revision": { "type": "null" }
      }
    },
    "courseOutcomes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/courseOutcome" }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lesson" }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["courseOutcomeCount", "lessonCount", "objectiveCount", "assessmentCount", "requiredCheckCount", "requiredCheckMappingBasis"],
      "properties": {
        "courseOutcomeCount": { "type": "integer", "minimum": 1 },
        "lessonCount": { "type": "integer", "minimum": 1 },
        "objectiveCount": { "type": "integer", "minimum": 1 },
        "assessmentCount": { "type": "integer", "minimum": 1 },
        "requiredCheckCount": { "type": "integer", "minimum": 1 },
        "requiredCheckMappingBasis": { "const": "assessment-objective-closure" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "minLength": 1 },
    "idArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "courseOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "courseOutcomeIds", "statement"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "courseOutcomeIds": { "$ref": "#/$defs/idArray" },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifactStatus", "objectiveIds", "type", "artifactSetRef", "requiredCheckIds", "evidence", "passCriteria"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "artifactStatus": { "enum": ["implemented", "planned"] },
        "objectiveIds": { "$ref": "#/$defs/nonEmptyIdArray" },
        "type": { "type": "string", "minLength": 1 },
        "artifactSetRef": { "type": "string", "minLength": 1 },
        "requiredCheckIds": { "$ref": "#/$defs/nonEmptyIdArray" },
        "evidence": { "type": "string", "minLength": 1 },
        "passCriteria": { "type": "string", "minLength": 1 }
      }
    },
    "requiredCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "assessmentId", "objectiveIds", "courseOutcomeIds", "evidenceType", "required", "mappingBasis"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "mode": { "const": "lab" },
        "assessmentId": { "$ref": "#/$defs/id" },
        "objectiveIds": { "$ref": "#/$defs/nonEmptyIdArray" },
        "courseOutcomeIds": { "$ref": "#/$defs/idArray" },
        "evidenceType": { "type": "string", "minLength": 1 },
        "required": { "const": true },
        "mappingBasis": { "const": "assessment-objective-closure" }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "module", "articleSlug", "environmentRef", "learningPrerequisites", "estimatedMinutes", "extensionMinutes", "extensionTaskRef", "readingAssessmentRef", "objectives", "assessments", "requiredChecks"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "articleSlug": { "type": ["string", "null"] },
        "environmentRef": { "type": "string", "pattern": "^curriculum/support-matrix\\.json#lessons\\.[A-Za-z0-9._-]+$" },
        "learningPrerequisites": { "$ref": "#/$defs/idArray" },
        "estimatedMinutes": { "type": "integer", "minimum": 0 },
        "extensionMinutes": { "type": "integer", "minimum": 0 },
        "extensionTaskRef": { "type": ["string", "null"], "pattern": "^course/lessons/[A-Za-z0-9._-]+/extension\\.yaml$" },
        "readingAssessmentRef": { "type": ["string", "null"], "pattern": "^episodes/[0-9]{2}-[A-Za-z0-9._-]+/assessment\\.yaml#AA[0-9]{2}-A1$" },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/objective" }
        },
        "assessments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assessment" }
        },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/requiredCheck" }
        }
      }
    },
    "nonEmptyIdArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    }
  }
}

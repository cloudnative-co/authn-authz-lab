{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudnative.co.jp/schemas/auth-authz/process-control-secret.schema.json",
  "title": "Course managed process control secret",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "resourceId", "generationId", "instanceId", "status", "shutdownToken", "createdAt", "retiredAt"],
  "properties": {
    "$schema": { "const": "curriculum/schemas/process-control-secret.schema.json" },
    "schemaVersion": { "const": 1 },
    "resourceId": { "$ref": "#/$defs/resourceId" },
    "generationId": { "$ref": "#/$defs/generationId" },
    "instanceId": { "$ref": "#/$defs/instanceId" },
    "status": { "enum": ["active", "retired"] },
    "shutdownToken": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 43, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" }
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "retiredAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "resourceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "generationId": { "type": "string", "pattern": "^gen-[a-f0-9]{32}$" },
    "instanceId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,128}\\.[A-Za-z0-9_-]{3,128}$" }
  }
}

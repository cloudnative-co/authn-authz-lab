{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudnative.co.jp/schemas/auth-authz/managed-process-launch.schema.json",
  "title": "Course managed process launch intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "resourceId", "generationId", "status", "launchProtocol", "gateTimeoutMs", "installId", "runId", "instanceId", "origin", "createdAt", "abortedAt", "abortReasonCode"],
  "properties": {
    "$schema": { "const": "curriculum/schemas/managed-process-launch.schema.json" },
    "schemaVersion": { "const": 2 },
    "resourceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "generationId": { "type": "string", "pattern": "^gen-[a-f0-9]{32}$" },
    "status": { "enum": ["pending", "aborted"] },
    "launchProtocol": { "const": "current-record-gated-v1" },
    "gateTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 5000 },
    "installId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,128}$" },
    "instanceId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,128}\\.[A-Za-z0-9_-]{3,128}$" },
    "origin": { "type": "string", "pattern": "^http://(?:127\\.0\\.0\\.1|\\[::1\\]):[1-9][0-9]{0,4}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "abortedAt": { "type": ["string", "null"], "format": "date-time" },
    "abortReasonCode": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
      ]
    }
  }
}

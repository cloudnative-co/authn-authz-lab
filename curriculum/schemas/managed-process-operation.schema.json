{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudnative.co.jp/schemas/auth-authz/managed-process-operation.schema.json",
  "title": "Course managed process operation lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "resourceId", "operationId", "command", "pid", "instanceId", "processStartFingerprint", "createdAt"],
  "properties": {
    "$schema": { "const": "curriculum/schemas/managed-process-operation.schema.json" },
    "schemaVersion": { "const": 1 },
    "resourceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "operationId": { "type": "string", "pattern": "^op-[a-f0-9]{32}$" },
    "command": { "enum": ["start", "stop", "recover"] },
    "pid": { "type": "integer", "minimum": 1 },
    "instanceId": { "type": "string", "pattern": "^[a-f0-9]{32}\\.operation-[a-f0-9]{32}$" },
    "processStartFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudnative.co.jp/schemas/auth-authz/journal.schema.json",
  "title": "Append-only course operation journal entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "sequence", "runId", "courseId", "lessonId", "command", "lockMode", "resourceIds", "status", "evidenceId", "timestamp"],
  "properties": {
    "$schema": { "const": "curriculum/schemas/journal.schema.json" },
    "schemaVersion": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "runId": { "$ref": "#/$defs/id" },
    "courseId": { "$ref": "#/$defs/id" },
    "lessonId": { "type": ["string", "null"] },
    "command": { "enum": ["doctor", "setup", "demo", "observe", "check", "diagnose", "reset", "stop", "purge"] },
    "lockMode": { "enum": ["none", "read", "write"] },
    "resourceIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "status": { "enum": ["pass", "fail", "blocked", "safe-noop"] },
    "evidenceId": { "type": ["string", "null"] },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 }
  }
}

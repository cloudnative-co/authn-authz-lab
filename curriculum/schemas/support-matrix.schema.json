{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudnative.co.jp/schemas/auth-authz/support-matrix.schema.json",
  "title": "Course support matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "courseId", "statusDefinitions", "profiles", "lessons"],
  "properties": {
    "$schema": { "const": "./schemas/support-matrix.schema.json" },
    "schemaVersion": { "const": 1 },
    "courseId": { "$ref": "#/$defs/id" },
    "statusDefinitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "experimental", "planned"],
      "properties": {
        "candidate": { "type": "string", "minLength": 1 },
        "experimental": { "type": "string", "minLength": 1 },
        "planned": { "type": "string", "minLength": 1 }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lesson" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "os", "architecture", "nodeMajor", "containerEngine", "status", "ciJob", "verifiedRevision", "lastVerifiedAt", "humanPilot"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "os": { "enum": ["macos", "linux", "wsl2-linux-filesystem", "windows"] },
        "architecture": { "enum": ["arm64", "x64"] },
        "nodeMajor": { "enum": [24, 26] },
        "containerEngine": { "type": "string", "minLength": 1 },
        "status": { "enum": ["candidate", "experimental"] },
        "ciJob": { "type": ["string", "null"] },
        "verifiedRevision": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
          ]
        },
        "lastVerifiedAt": { "type": ["string", "null"], "format": "date-time" },
        "humanPilot": { "type": "boolean" }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "profileIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["candidate", "experimental", "planned"] },
        "profileIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    }
  }
}

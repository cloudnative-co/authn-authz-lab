{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudnative.co.jp/schemas/auth-authz/managed-process.schema.json",
  "title": "Course managed process record",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "resourceId", "generationId", "status", "pid", "instanceId", "origin", "startFingerprint", "startedAt", "updatedAt", "stoppedAt", "stopMethod", "stopReasonCode"],
  "properties": {
    "$schema": { "const": "curriculum/schemas/managed-process.schema.json" },
    "schemaVersion": { "const": 1 },
    "resourceId": { "$ref": "#/$defs/resourceId" },
    "generationId": { "$ref": "#/$defs/generationId" },
    "status": { "enum": ["running", "stopped"] },
    "pid": { "type": "integer", "minimum": 1 },
    "instanceId": { "$ref": "#/$defs/instanceId" },
    "origin": { "type": "string", "pattern": "^http://(?:127\\.0\\.0\\.1|\\[::1\\]):[1-9][0-9]{0,4}$" },
    "startFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "stoppedAt": { "type": ["string", "null"], "format": "date-time" },
    "stopMethod": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["authenticated-shutdown", "already-gone", "rollback-child-handle", "activation-aborted"] }
      ]
    },
    "stopReasonCode": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
      ]
    }
  },
  "$defs": {
    "resourceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "generationId": { "type": "string", "pattern": "^gen-[a-f0-9]{32}$" },
    "instanceId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,128}\\.[A-Za-z0-9_-]{3,128}$" }
  }
}
